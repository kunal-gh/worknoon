# Choose gemini or groq. Gemini is the documented default because it has a free API path.
LLM_PROVIDER=gemini

# Free-tier key options. Provide at least one.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Optional model overrides.
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Backend settings.
DATABASE_URL=sqlite:////app/data/worknoon_refunds.db
BUSINESS_TODAY=2026-06-01
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

