# ──────────────────────────────────────────────────────────────────────────────
# LLM Provider Configuration
# Choose one of: gemini | groq | openai | mock
# "mock" uses a local heuristic extractor with no API key required (demo only).
# ──────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# Free-tier key options — provide at least one API key.
# Gemini (recommended default — free tier available):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Groq (fast inference, free tier available):
#   https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# OpenAI / ChatGPT (as mentioned in the assignment brief):
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ──────────────────────────────────────────────────────────────────────────────
# Optional model overrides
# ──────────────────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# ──────────────────────────────────────────────────────────────────────────────
# Backend settings
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////app/data/worknoon_refunds.db
BUSINESS_TODAY=2026-06-01
FRONTEND_ORIGIN=http://localhost:3085
NEXT_PUBLIC_API_BASE_URL=http://localhost:8085
